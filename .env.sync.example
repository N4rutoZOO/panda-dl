# Dingo-dl Playlist Sync
# Never commit real client secrets.

# Public Cloud Run URL, e.g. https://dingo-dl-xxxxx.europe-west1.run.app
DINGO_PUBLIC_URL=

# Spotify Developer Dashboard
DINGO_SPOTIFY_CLIENT_ID=
# Production: inject this from Secret Manager as env DINGO_SPOTIFY_CLIENT_SECRET
DINGO_SPOTIFY_CLIENT_SECRET=
# Suggested Secret Manager name: dingo-spotify-client-secret

# Google OAuth client (Web application; YouTube Data API v3 enabled)
DINGO_GOOGLE_CLIENT_ID=
# Production: inject this from Secret Manager as env DINGO_GOOGLE_CLIENT_SECRET
DINGO_GOOGLE_CLIENT_SECRET=
# Suggested Secret Manager name: dingo-google-client-secret

# Secure persistence
DINGO_FIRESTORE_ENABLED=1
DINGO_FIRESTORE_PROJECT=
# Production: inject from Secret Manager (suggested name: dingo-token-key)
DINGO_TOKEN_KEY=

# Matching / jobs
DINGO_SYNC_MATCH_THRESHOLD=0.78
DINGO_SYNC_MAX_TRACKS=500
DINGO_SYNC_WORKERS=2
DINGO_MATCH_CACHE_TTL=1209600
DINGO_MATCH_EMPTY_TTL=86400
