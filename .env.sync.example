# Dingo-dl Playlist Sync
# Never commit real client secrets or token keys.

# Public Cloud Run URL, e.g. https://dingo-dl-xxxxx.europe-west1.run.app
DINGO_PUBLIC_URL=

# Spotify Developer Dashboard
DINGO_SPOTIFY_CLIENT_ID=
DINGO_SPOTIFY_CLIENT_SECRET=

# Google Cloud OAuth client (YouTube Data API v3 enabled)
DINGO_GOOGLE_CLIENT_ID=
DINGO_GOOGLE_CLIENT_SECRET=

# Matching / jobs
DINGO_SYNC_MATCH_THRESHOLD=0.78
DINGO_SYNC_MAX_TRACKS=500
DINGO_SYNC_WORKERS=2

# Persistent sync storage
DINGO_FIRESTORE_ENABLED=1
DINGO_FIRESTORE_PROJECT=

# Fernet key used ONLY to encrypt OAuth tokens before Firestore writes.
# Generate with: python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# In production, inject this value from Google Secret Manager, do not commit it.
DINGO_TOKEN_KEY=

# Matching cache: successful searches 14 days, empty searches 24 hours
DINGO_MATCH_CACHE_TTL=1209600
DINGO_MATCH_EMPTY_TTL=86400
